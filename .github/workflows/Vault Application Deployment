name: Vault Application Deployment

on:
  push:
    branches:
      - develop
      - staging
  pull_request:
    branches:
      - main
      - staging
  release:
    types: [published]

env:
  NODE_VERSION: '18.x'

jobs:
  # CI Pipeline - Runs on all branches
  ci-pipeline:
    runs-on: ubuntu-latest
    if: github.event_name == 'push' || github.event_name == 'pull_request'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: ${{ env.NODE_VERSION }}
        cache: 'npm'
        
    - name: Install dependencies
      run: npm ci
      
    - name: Run tests
      run: npm test
      
    - name: Run linting
      run: npm run lint
      
    - name: Build application
      run: npm run build
      
    - name: Upload build artifacts
      uses: actions/upload-artifact@v4
      with:
        name: build-artifacts
        path: |
          dist/
          build/
        retention-days: 7

  # Development Environment Deployment
  deploy-dev:
    runs-on: ubuntu-latest
    environment: dev
    needs: ci-pipeline
    if: github.ref == 'refs/heads/develop'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Download build artifacts
      uses: actions/download-artifact@v4
      with:
        name: build-artifacts
        
    - name: Setup Vault CLI
      run: |
        wget -O- https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
        echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list
        sudo apt update && sudo apt install vault
        
    - name: Start Vault Dev Server
      run: |
        vault server -dev -dev-listen-address="0.0.0.0:8200" -dev-root-token-id="dev-token-123" &
        sleep 5
        
    - name: Configure Vault and Deploy
      run: |
        export VAULT_ADDR="http://127.0.0.1:8200"
        export VAULT_TOKEN="dev-token-123"
        
        # Wait for Vault to be ready
        until vault status; do
          echo "Waiting for Vault..."
          sleep 2
        done
        
        echo "🚀 Deploying to Development Environment"
        
        # Store deployment secrets in Vault
        vault kv put secret/dev/database url="dev-db.example.com" username="dev_user" password="${{ secrets.DEV_DB_PASSWORD }}"
        vault kv put secret/dev/api keys="${{ secrets.DEV_API_KEY }}"
        
        # Simulate deployment steps
        echo "✅ Application deployed to Development"
        echo "Deployment Version: ${{ github.sha }}"
        echo "Branch: ${{ github.ref }}"
        
    - name: Integration Tests
      run: |
        export VAULT_ADDR="http://127.0.0.1:8200"
        export VAULT_TOKEN="dev-token-123"
        
        echo "Running integration tests..."
        vault kv get secret/dev/database
        echo "✅ Development environment tests passed"

  # Staging Environment Deployment
  deploy-staging:
    runs-on: ubuntu-latest
    environment: staging
    if: github.ref == 'refs/heads/staging'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Download build artifacts
      uses: actions/download-artifact@v4
      with:
        name: build-artifacts
        
    - name: Setup Vault CLI
      run: |
        wget -O- https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
        echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list
        sudo apt update && sudo apt install vault
        
    - name: Start Vault for Staging
      run: |
        vault server -dev -dev-listen-address="0.0.0.0:8201" -dev-root-token-id="staging-token-456" &
        sleep 5
        
    - name: Deploy to Staging
      run: |
        export VAULT_ADDR="http://127.0.0.1:8201"
        export VAULT_TOKEN="staging-token-456"
        
        # Wait for Vault to be ready
        until vault status; do
          echo "Waiting for Vault..."
          sleep 2
        done
        
        echo "🚀 Deploying to Staging Environment"
        
        # Store staging secrets
        vault kv put secret/staging/database url="staging-db.example.com" username="staging_user" password="${{ secrets.STAGING_DB_PASSWORD }}"
        vault kv put secret/staging/api keys="${{ secrets.STAGING_API_KEY }}"
        
        echo "✅ Application deployed to Staging"
        echo "Deployment Version: ${{ github.sha }}"
        echo "Branch: ${{ github.ref }}"
        
    - name: Staging Smoke Tests
      run: |
        export VAULT_ADDR="http://127.0.0.1:8201"
        export VAULT_TOKEN="staging-token-456"
        
        echo "Running smoke tests on staging..."
        vault kv get secret/staging/database
        echo "✅ Staging environment tests passed"

  # Production Deployment (Manual Approval)
  deploy-production:
    runs-on: ubuntu-latest
    environment: production
    if: github.event_name == 'release' && github.event.action == 'published'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Download build artifacts
      uses: actions/download-artifact@v4
      with:
        name: build-artifacts
        
    - name: Setup Vault CLI
      run: |
        wget -O- https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
        echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list
        sudo apt update && sudo apt install vault
        
    - name: Start Vault for Production
      run: |
        vault server -dev -dev-listen-address="0.0.0.0:8202" -dev-root-token-id="prod-token-789" &
        sleep 5
        
    - name: Deploy to Production
      run: |
        export VAULT_ADDR="http://127.0.0.1:8202"
        export VAULT_TOKEN="prod-token-789"
        
        # Wait for Vault to be ready
        until vault status; do
          echo "Waiting for Vault..."
          sleep 2
        done
        
        echo "🚀 Deploying to Production Environment"
        echo "Release Version: ${{ github.event.release.tag_name }}"
        
        # Store production secrets
        vault kv put secret/production/database url="prod-db.example.com" username="prod_user" password="${{ secrets.PROD_DB_PASSWORD }}"
        vault kv put secret/production/api keys="${{ secrets.PROD_API_KEY }}"
        
        echo "✅ Production deployment completed successfully!"
        echo "Version: ${{ github.event.release.tag_name }}"
        
    - name: Production Health Check
      run: |
        export VAULT_ADDR="http://127.0.0.1:8202"
        export VAULT_TOKEN="prod-token-789"
        
        echo "Running production health checks..."
        vault kv get secret/production/database
        echo "✅ Production health checks passed"

  # Release Creation
  create-release:
    runs-on: ubuntu-latest
    environment: staging
    if: github.ref == 'refs/heads/staging' && github.event_name == 'push'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Create Release
      uses: actions/create-release@v1
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      with:
        tag_name: v1.0.${{ github.run_number }}
        release_name: Release v1.0.${{ github.run_number }}
        body: |
          Automated release from staging environment
          - Build: ${{ github.sha }}
          - Environment: Staging
          - Workflow: ${{ github.workflow }}
        draft: false
        prerelease: false
