name: Vault Application Deployment

on:
  push:
    branches:
      - develop
      - staging
      - 'release/**'
      - 'hotfix/**'
  pull_request:
    branches:
      - main
      - staging
  release:
    types: [published]

env:
  VAULT_ADDR: "http://127.0.0.1:8200"
  NODE_VERSION: '18.x'

jobs:
  # CI Pipeline - Runs on all branches
  ci-pipeline:
    runs-on: ubuntu-latest
    if: github.event_name == 'push' || github.event_name == 'pull_request'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: ${{ env.NODE_VERSION }}
        cache: 'npm'
        
    - name: Install dependencies
      run: npm ci
      
    - name: Run tests
      run: npm test
      
    - name: Run linting
      run: npm run lint
      
    - name: Build application
      run: npm run build
      
    - name: Upload build artifacts
      uses: actions/upload-artifact@v4
      with:
        name: build-artifacts
        path: |
          dist/
          build/
        retention-days: 7

  # Development Environment Deployment
  deploy-dev:
    runs-on: windows-latest
    environment: dev
    needs: ci-pipeline
    if: github.ref == 'refs/heads/develop' && github.event_name == 'push'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Download build artifacts
      uses: actions/download-artifact@v4
      with:
        name: build-artifacts
        
    - name: Setup Vault for Development
      run: |
        Invoke-WebRequest -Uri "https://releases.hashicorp.com/vault/1.21.0/vault_1.21.0_windows_amd64.zip" -OutFile "vault.zip"
        Expand-Archive -Path "vault.zip" -DestinationPath "." -Force
        
    - name: Start Vault Dev Server
      run: |
        # Start Vault with development configuration
        Start-Process -FilePath ".\vault.exe" -ArgumentList "server -dev -dev-listen-address=127.0.0.1:8200 -dev-root-token-id=dev-token-123" -WindowStyle Hidden
        
        # Wait for Vault to be ready
        $maxRetries = 30
        $retryCount = 0
        do {
            try {
                $response = Invoke-WebRequest -Uri "http://127.0.0.1:8200/v1/sys/health" -ErrorAction SilentlyContinue
                if ($response.StatusCode -eq 200) { break }
            } catch {
                Start-Sleep -Seconds 1
                $retryCount++
            }
        } while ($retryCount -lt $maxRetries)
        
    - name: Deploy to Development
      run: |
        $env:VAULT_ADDR="http://127.0.0.1:8200"
        $env:VAULT_TOKEN="dev-token-123"
        
        # Deploy application with dev configuration
        echo "Deploying to Development Environment"
        
        # Store deployment secrets in Vault
        .\vault.exe kv put secret/dev/database url="dev-db.example.com" username="dev_user" password="${{ secrets.DEV_DB_PASSWORD }}"
        .\vault.exe kv put secret/dev/api keys="${{ secrets.DEV_API_KEY }}"
        
        # Simulate deployment
        echo "✅ Application deployed to Development"
        echo "Deployment Version: ${{ github.sha }}"
        echo "Environment: Development"
        
    - name: Integration Tests
      run: |
        $env:VAULT_ADDR="http://127.0.0.1:8200"
        $env:VAULT_TOKEN="dev-token-123"
        
        # Run integration tests against dev environment
        echo "Running integration tests..."
        .\vault.exe kv get secret/dev/database
        # Add your actual integration test commands here
        
    - name: Stop Vault
      if: always()
      run: |
        Get-Process -Name "vault" -ErrorAction SilentlyContinue | Stop-Process -Force

  # Staging Environment Deployment
  deploy-staging:
    runs-on: windows-latest
    environment: staging
    needs: [ci-pipeline, deploy-dev]
    if: github.ref == 'refs/heads/staging' && github.event_name == 'push'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Download build artifacts
      uses: actions/download-artifact@v4
      with:
        name: build-artifacts
        
    - name: Setup Vault for Staging
      run: |
        Invoke-WebRequest -Uri "https://releases.hashicorp.com/vault/1.21.0/vault_1.21.0_windows_amd64.zip" -OutFile "vault.zip"
        Expand-Archive -Path "vault.zip" -DestinationPath "." -Force
        
    - name: Start Vault for Staging
      run: |
        Start-Process -FilePath ".\vault.exe" -ArgumentList "server -dev -dev-listen-address=127.0.0.1:8201 -dev-root-token-id=staging-token-456" -WindowStyle Hidden
        
        # Wait for Vault to be ready
        $maxRetries = 30
        $retryCount = 0
        do {
            try {
                $response = Invoke-WebRequest -Uri "http://127.0.0.1:8201/v1/sys/health" -ErrorAction SilentlyContinue
                if ($response.StatusCode -eq 200) { break }
            } catch {
                Start-Sleep -Seconds 1
                $retryCount++
            }
        } while ($retryCount -lt $maxRetries)
        
    - name: Deploy to Staging
      run: |
        $env:VAULT_ADDR="http://127.0.0.1:8201"
        $env:VAULT_TOKEN="staging-token-456"
        
        echo "Deploying to Staging Environment"
        
        # Store staging secrets
        .\vault.exe kv put secret/staging/database url="staging-db.example.com" username="staging_user" password="${{ secrets.STAGING_DB_PASSWORD }}"
        .\vault.exe kv put secret/staging/api keys="${{ secrets.STAGING_API_KEY }}"
        
        echo "✅ Application deployed to Staging"
        echo "Deployment Version: ${{ github.sha }}"
        echo "Environment: Staging"
        
    - name: Staging Smoke Tests
      run: |
        $env:VAULT_ADDR="http://127.0.0.1:8201"
        $env:VAULT_TOKEN="staging-token-456"
        
        echo "Running smoke tests on staging..."
        # Add staging smoke tests here
        
    - name: Stop Vault
      if: always()
      run: |
        Get-Process -Name "vault" -ErrorAction SilentlyContinue | Stop-Process -Force

  # Production Deployment (Manual Approval)
  deploy-production:
    runs-on: windows-latest
    environment: production
    needs: [ci-pipeline, deploy-staging]
    if: github.event_name == 'release' && github.event.action == 'published'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Download build artifacts
      uses: actions/download-artifact@v4
      with:
        name: build-artifacts
        
    - name: Setup Vault for Production
      run: |
        Invoke-WebRequest -Uri "https://releases.hashicorp.com/vault/1.21.0/vault_1.21.0_windows_amd64.zip" -OutFile "vault.zip"
        Expand-Archive -Path "vault.zip" -DestinationPath "." -Force
        
    - name: Start Vault for Production
      run: |
        Start-Process -FilePath ".\vault.exe" -ArgumentList "server -dev -dev-listen-address=127.0.0.1:8202 -dev-root-token-id=prod-token-789" -WindowStyle Hidden
        
        # Wait for Vault to be ready
        $maxRetries = 30
        $retryCount = 0
        do {
            try {
                $response = Invoke-WebRequest -Uri "http://127.0.0.1:8202/v1/sys/health" -ErrorAction SilentlyContinue
                if ($response.StatusCode -eq 200) { break }
            } catch {
                Start-Sleep -Seconds 1
                $retryCount++
            }
        } while ($retryCount -lt $maxRetries)
        
    - name: Deploy to Production
      run: |
        $env:VAULT_ADDR="http://127.0.0.1:8202"
        $env:VAULT_TOKEN="prod-token-789"
        
        echo "🚀 Deploying to Production Environment"
        echo "Release Version: ${{ github.event.release.tag_name }}"
        echo "Release Notes: ${{ github.event.release.body }}"
        
        # Store production secrets
        .\vault.exe kv put secret/production/database url="prod-db.example.com" username="prod_user" password="${{ secrets.PROD_DB_PASSWORD }}"
        .\vault.exe kv put secret/production/api keys="${{ secrets.PROD_API_KEY }}"
        
        echo "✅ Production deployment completed successfully!"
        echo "Version: ${{ github.event.release.tag_name }}"
        
    - name: Production Health Check
      run: |
        $env:VAULT_ADDR="http://127.0.0.1:8202"
        $env:VAULT_TOKEN="prod-token-789"
        
        echo "Running production health checks..."
        # Add production health checks here
        
    - name: Stop Vault
      if: always()
      run: |
        Get-Process -Name "vault" -ErrorAction SilentlyContinue | Stop-Process -Force

  # Release Creation Workflow
  create-release:
    runs-on: ubuntu-latest
    needs: deploy-staging
    if: github.ref == 'refs/heads/staging' && github.event_name == 'push'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Create Release
      uses: actions/create-release@v1
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      with:
        tag_name: v${{ github.run_number }}
        release_name: Release v${{ github.run_number }}
        body: |
          Automated release from staging environment
          - Build: ${{ github.sha }}
          - Environment: Staging
          - Date: ${{ github.event.head_commit.timestamp }}
        draft: true
        prerelease: false
